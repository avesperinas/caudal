# ─── Desarrollo ──────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://finances:finances_dev@localhost:5432/my_finances"
AUTH_SECRET="run: npx auth secret"
AUTH_GOOGLE_ID="from Google Cloud Console"
AUTH_GOOGLE_SECRET="from Google Cloud Console"

# Backup mensual (Resend) — opcional
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
BACKUP_FROM_EMAIL="backup@tu-dominio.com"

# ─── Producción (servidor con Cloudflare Tunnel) ─────────────────────────────
# Descomenta y ajusta cuando despliegues con `make prod`.
#
# URL pública detrás del tunnel (sin barra final).
# AUTH_URL="https://caudal.tudominio.com"
# AUTH_TRUST_HOST="true"
#
# Credenciales propias de la BD (sustituyen los defaults de desarrollo).
# Genera el password con: openssl rand -base64 32
# POSTGRES_USER="finances"
# POSTGRES_PASSWORD="cambia_esto_por_uno_aleatorio"
# POSTGRES_DB="my_finances"
#
# Token del tunnel (Cloudflare Zero Trust → Networks → Tunnels → tu tunnel).
# CLOUDFLARE_TUNNEL_TOKEN="eyJh..."
