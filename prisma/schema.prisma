generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js required models ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  sentFriendRequests     Friendship[] @relation("FriendshipSender")
  receivedFriendRequests Friendship[] @relation("FriendshipReceiver")
  sharedAccountOwned     SharedAccountAccess[] @relation("SharedAccountOwner")
  sharedAccountAccess    SharedAccountAccess[] @relation("SharedAccountCollaborator")
  entities    Entity[]
  products    Product[]
  snapshots   ProductSnapshot[]

  sharedYearConfigs    SharedYearConfig[]
  personIncomes        SharedPersonIncome[]
  sharedCategories     SharedCategory[]
  sharedExpenses       SharedExpense[]
  sharedDeposits       SharedDeposit[]

  personalCategories   PersonalCategory[]
  personalTransactions PersonalTransaction[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Dominio ──────────────────────────────────────────────────────────────────

model Friendship {
  id        String           @id @default(cuid())
  senderId  String
  receiverId String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  sender   User @relation("FriendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model SharedAccountAccess {
  id                 String   @id @default(cuid())
  ownerUserId        String
  collaboratorUserId String
  createdAt          DateTime @default(now())

  owner        User @relation("SharedAccountOwner",        fields: [ownerUserId],        references: [id], onDelete: Cascade)
  collaborator User @relation("SharedAccountCollaborator", fields: [collaboratorUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, collaboratorUserId])
}

// ─── Productos / Patrimonio ───────────────────────────────────────────────────

model Entity {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  userId           String
  entityId         String
  name             String
  type             ProductType
  ownership        Float
  countForSavings  Boolean     @default(true)
  openedAt         DateTime    @db.Date
  closedAt         DateTime?   @db.Date
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    Entity            @relation(fields: [entityId], references: [id])
  snapshots ProductSnapshot[]
  personalTransactions PersonalTransaction[]
  sharedYearConfigs    SharedYearConfig[]
}

model ProductSnapshot {
  id        String   @id @default(cuid())
  productId String
  userId    String
  value     Float
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
}

// ─── Gastos comunes (pareja) ──────────────────────────────────────────────────

model SharedYearConfig {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  person1Name String   @default("Persona 1")
  person2Name String   @default("Persona 2")
  settled     Boolean  @default(false)
  productId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, year])
}

model SharedPersonIncome {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  person    Int      // 1 o 2
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  salary    Float    // neto anual
  extra     Float    @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
}

model SharedCategory {
  id        String    @id @default(cuid())
  userId    String
  name      String
  splitType SplitType
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses SharedExpense[]

  @@unique([userId, name])
}

enum SplitType {
  FIFTY_FIFTY
  PROPORTIONAL
}

model SharedExpense {
  id         String      @id @default(cuid())
  userId     String
  categoryId String
  year       Int
  month      Int
  amount     Float
  paidBy     SharedPayer
  note       String?
  createdAt  DateTime    @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category SharedCategory @relation(fields: [categoryId], references: [id])
}

model SharedDeposit {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int
  person    Int
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SharedPayer {
  ACCOUNT
  PERSON1
  PERSON2
}

// ─── Finanzas personales ──────────────────────────────────────────────────────

enum PersonalCategoryType {
  INCOME
  EXPENSE
}

model PersonalCategory {
  id                     String               @id @default(cuid())
  userId                 String
  name                   String
  type                   PersonalCategoryType
  order                  Int                  @default(0)
  isActive               Boolean              @default(true)
  countForExtendedSavings Boolean             @default(false)
  createdAt              DateTime             @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]

  @@index([userId])
}

model PersonalTransaction {
  id         String   @id @default(cuid())
  userId     String
  year       Int
  month      Int
  date       DateTime? @db.Date
  amount     Float
  type       PersonalTransactionType
  categoryId String?
  productId  String?
  madeByMe   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category PersonalCategory? @relation(fields: [categoryId], references: [id])
  product  Product?          @relation(fields: [productId], references: [id])

  @@index([userId, year])
}

enum PersonalTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ProductType {
  CHECKING
  SAVINGS
  FUND
  PENSION
  ETF
  REAL_ESTATE
  CRYPTO
  OTHER
}
